{
  "name": "@hospitalos/api",
  "version": "0.1.0",
  "private": true,
  "description": "HospitalOS Mobile independent API (Express 5, PostgreSQL 17, Drizzle).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "build": "tsc --noEmit -p .",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate-cli.ts dev",
    "db:migrate:test": "tsx --env-file=../../.env src/db/migrate-cli.ts test",
    "db:env:check": "tsx --env-file=../../.env src/config/check-cli.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hospitalos/contracts": "*",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
