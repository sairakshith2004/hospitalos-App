# Public, non-secret build-time settings only.
# EXPO_PUBLIC_* values are embedded in the app bundle and visible to anyone.
# Never put API keys, tokens, passwords or patient data in this file or in .env.

# One of: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# HospitalOS API base URL (public). Development default: http://127.0.0.1:4000.
# Android emulator: http://10.0.2.2:4000. Physical phone: your computer's LAN address.
# HTTPS is required outside development.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
