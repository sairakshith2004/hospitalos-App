{
  "name": "hospitalos-app",
  "private": true,
  "description": "HospitalOS monorepo: independent API, browser app and shared contracts. The Expo mobile app keeps its own lockfile in apps/mobile.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "npm run dev -w @hospitalos/api",
    "dev:web": "npm run dev -w @hospitalos/web",
    "start:api": "npm run start -w @hospitalos/api",
    "build:api": "npm run build -w @hospitalos/api",
    "build:web": "npm run build -w @hospitalos/web",
    "build": "npm run build:web && npm run build:api",
    "start:dist": "npm run start:dist -w @hospitalos/api",
    "stop:api": "npm run stop -w @hospitalos/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces",
    "test:api": "npm test -w @hospitalos/api",
    "test:db": "npm run test:db -w @hospitalos/api",
    "env:init": "node scripts/env-init.mjs",
    "iso:check": "node scripts/iso-check.mjs",
    "db:up": "docker compose -p hospitalos-mobile up -d --wait db",
    "mail:up": "docker compose -p hospitalos-mobile up -d mail",
    "db:seed": "npm run db:seed -w @hospitalos/api",
    "db:seed:test": "npm run db:seed:test -w @hospitalos/api",
    "db:seed:demo": "npm run db:seed:demo -w @hospitalos/api",
    "api:bootstrap-admin": "npm run bootstrap-admin -w @hospitalos/api",
    "api:reset-password": "npm run reset-password -w @hospitalos/api",
    "db:down": "docker compose -p hospitalos-mobile down",
    "db:init": "sh scripts/db-init.sh",
    "db:migrate": "npm run db:migrate -w @hospitalos/api",
    "db:migrate:test": "npm run db:migrate:test -w @hospitalos/api",
    "db:env:check": "npm run db:env:check -w @hospitalos/api",
    "secrets:check": "node scripts/secrets-check.mjs",
    "audit": "node scripts/mobile-audit.mjs root",
    "mobile:check": "npm --prefix apps/mobile run check",
    "mobile:audit": "node scripts/mobile-audit.mjs",
    "check": "npm run secrets:check && npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
