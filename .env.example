# HospitalOS Mobile local settings (one file for Docker Compose and the API).
# `npm run env:init` writes the real, git-ignored .env with random values (mode 600).
# Placeholders only. Never commit real values. Never put these in EXPO_PUBLIC_* variables.

# --- PostgreSQL container (Compose project "hospitalos-mobile") ---
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
HOS_OWNER_PASSWORD=change-me
HOS_APP_PASSWORD=change-me

# --- API ---
NODE_ENV=development
# 127.0.0.1 by default. For a physical phone on your Wi-Fi, see README "Physical Android device".
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# The API connects as hos_app (least privilege) to hospitalos_dev on the isolated port 5433.
DATABASE_URL=postgres://hos_app:change-me@127.0.0.1:5433/hospitalos_dev
DATABASE_ALLOWED_NAMES=hospitalos_dev

# Migrations run as hos_owner. Database tests use hospitalos_test only.
MIGRATION_DATABASE_URL=postgres://hos_owner:change-me@127.0.0.1:5433/hospitalos_dev
TEST_DATABASE_URL=postgres://hos_app:change-me@127.0.0.1:5433/hospitalos_test
TEST_MIGRATION_DATABASE_URL=postgres://hos_owner:change-me@127.0.0.1:5433/hospitalos_test

# Any *_DATABASE_URL can instead be given as NAME_FILE=/path/to/file (container secrets).
